<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_gradient">

    <!-- 主界面内容区（包含顶部导航与歌单/歌曲列表） -->
    <LinearLayout
        android:id="@+id/layoutMainContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/layoutMiniPlayer"
        android:orientation="vertical">

        <!-- 顶部工具栏 -->
        <RelativeLayout
            android:id="@+id/layoutMainHeader"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/tvHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="Retro Subsonic"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnMainSettings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_btn_circle_default"
                android:contentDescription="Settings" />
        </RelativeLayout>

        <!-- 歌单列表与歌曲列表容器 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- 歌单视图 -->
            <ListView
                android:id="@+id/lvPlaylists"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="#22FFFFFF"
                android:dividerHeight="1dp" />

            <!-- 歌单歌曲详情二级视图 -->
            <LinearLayout
                android:id="@+id/layoutPlaylistDetail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#1B1B1E"
                android:orientation="vertical"
                android:visibility="gone">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="#252528"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <ImageButton
                        android:id="@+id/btnBackFromPlaylist"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_centerVertical="true"
                        android:background="@drawable/bg_btn_circle_default" />

                    <TextView
                        android:id="@+id/tvPlaylistDetailName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="12dp"
                        android:layout_toEndOf="@+id/btnBackFromPlaylist"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <ListView
                    android:id="@+id/lvPlaylistSongs"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:divider="#1AFFFFFF"
                    android:dividerHeight="1dp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- 首页底部迷你播放器 -->
    <RelativeLayout
        android:id="@+id/layoutMiniPlayer"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_alignParentBottom="true"
        android:background="#232328"
        android:clickable="true"
        android:elevation="8dp"
        android:focusable="true"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageView
            android:id="@+id/ivMiniCover"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_vinyl"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:id="@+id/layoutMiniInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_toStartOf="@+id/layoutMiniControls"
            android:layout_toEndOf="@+id/ivMiniCover"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvMiniTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="未在播放"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMiniArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="Retro Subsonic"
                android:textColor="#A0A0A0"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutMiniControls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnMiniPrev"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_btn_circle_default"
                android:padding="6dp" />

            <ImageButton
                android:id="@+id/btnMiniPlay"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_btn_circle_play"
                android:padding="6dp" />

            <ImageButton
                android:id="@+id/btnMiniNext"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_btn_circle_default"
                android:padding="6dp" />

            <ImageButton
                android:id="@+id/btnMiniQueue"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_btn_circle_default"
                android:padding="6dp" />
        </LinearLayout>
    </RelativeLayout>

    <!-- 播放详情页（全屏覆盖） -->
    <RelativeLayout
        android:id="@+id/layoutDetailPlayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#151518"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <!-- 详情页顶栏 -->
        <RelativeLayout
            android:id="@+id/layoutDetailHeader"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageButton
                android:id="@+id/btnDetailBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_btn_circle_default" />

            <TextView
                android:id="@+id/tvDetailHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="正在播放"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnDetailFav"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_btn_fav" />
        </RelativeLayout>

        <!-- 唱盘与唱针区域：向下调整位置，消除顶栏压迫感 -->
        <RelativeLayout
            android:id="@+id/flVinylContainer"
            android:layout_width="290dp"
            android:layout_height="290dp"
            android:layout_below="@+id/layoutDetailHeader"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="46dp">

            <ImageView
                android:id="@+id/ivVinyl"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_vinyl" />

            <ImageView
                android:id="@+id/ivCover"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:layout_centerInParent="true"
                android:scaleType="centerCrop" />

            <com.retro.subsonic.TonearmView
                android:id="@+id/tonearmView"
                android:layout_width="120dp"
                android:layout_height="170dp"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="-15dp" />
        </RelativeLayout>

        <!-- 歌曲信息 -->
        <LinearLayout
            android:id="@+id/layoutSongInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/flVinylContainer"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <TextView
                android:id="@+id/tvDetailTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:singleLine="true"
                android:text="歌曲名称"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDetailArtist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="歌手 - 专辑"
                android:textColor="#B0B0B0"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 歌词容器 -->
        <ScrollView
            android:id="@+id/scrollLyrics"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_below="@+id/layoutSongInfo"
            android:layout_marginTop="10dp"
            android:fillViewport="true"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <TextView
                android:id="@+id/tvDetailLyrics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="歌词加载中..."
                android:textColor="#CCCCCC"
                android:textSize="13sp" />
        </ScrollView>

        <!-- 播放进度控制条 -->
        <RelativeLayout
            android:id="@+id/layoutProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/scrollLyrics"
            android:layout_marginTop="12dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <SeekBar
                android:id="@+id/seekBarProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="1000"
                android:progressTint="#DDA35D"
                android:thumbTint="#DDA35D" />

            <TextView
                android:id="@+id/tvCurrentTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/seekBarProgress"
                android:layout_alignParentStart="true"
                android:layout_marginStart="8dp"
                android:text="00:00"
                android:textColor="#888888"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvTotalTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/seekBarProgress"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="8dp"
                android:text="00:00"
                android:textColor="#888888"
                android:textSize="11sp" />
        </RelativeLayout>

        <!-- 播放主控制按钮 -->
        <LinearLayout
            android:id="@+id/layoutDetailControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/layoutProgress"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnDetailMode"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_btn_circle_default"
                android:padding="8dp" />

            <ImageButton
                android:id="@+id/btnDetailPrev"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginEnd="18dp"
                android:background="@drawable/bg_btn_circle_default"
                android:padding="10dp" />

            <ImageButton
                android:id="@+id/btnDetailPlay"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_btn_circle_play"
                android:padding="12dp" />

            <ImageButton
                android:id="@+id/btnDetailNext"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="18dp"
                android:background="@drawable/bg_btn_circle_default"
                android:padding="10dp" />

            <ImageButton
                android:id="@+id/btnDetailQueue"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="20dp"
                android:background="@drawable/bg_btn_circle_default"
                android:padding="8dp" />
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
