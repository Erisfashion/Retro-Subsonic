<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#16181d">

    <!-- 第一层：主界面（媒体库浏览 + 侧边当前队列 + 底部控制） -->
    <LinearLayout
        android:id="@+id/layout_main_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- 顶栏：标题与服务器设置开关 -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:text="Subsonic Player"
                android:textColor="#ffffff"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_toggle_config"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:text="服务器设置"
                android:textSize="12sp" />
        </RelativeLayout>

        <!-- 可折叠的服务器配置面板（包含缓存大小与清理） -->
        <LinearLayout
            android:id="@+id/layout_config_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="8dp"
            android:layout_marginTop="4dp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

            <EditText
                android:id="@+id/et_server"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="服务器地址 (如 http://192.168.1.100:4533)"
                android:textColor="#ffffff"
                android:textColorHint="#777777"
                android:singleLine="true" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/et_username"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="用户名"
                    android:textColor="#ffffff"
                    android:textColorHint="#777777"
                    android:singleLine="true" />

                <EditText
                    android:id="@+id/et_password"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="密码"
                    android:textColor="#ffffff"
                    android:textColorHint="#777777"
                    android:inputType="textPassword"
                    android:singleLine="true" />
            </LinearLayout>

            <!-- 缓存容量控制排 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="本地缓存上限 (MB):"
                    android:textColor="#cccccc"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/et_cache_size"
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:text="500"
                    android:hint="500"
                    android:textColor="#ffffff"
                    android:textColorHint="#777777"
                    android:inputType="number"
                    android:gravity="center"
                    android:singleLine="true"
                    android:layout_marginLeft="6dp" />

                <Button
                    android:id="@+id/btn_clear_cache"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="清理缓存"
                    android:textSize="11sp"
                    android:layout_marginLeft="10dp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/btn_connect"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="保存并连接" />
            </LinearLayout>
        </LinearLayout>

        <!-- 导航切换 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <Button
                android:id="@+id/btn_tab_playlists"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="我的歌单" />

            <Button
                android:id="@+id/btn_tab_search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="搜索音乐" />
        </LinearLayout>

        <!-- 搜索输入框 -->
        <LinearLayout
            android:id="@+id/layout_search_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp"
            android:visibility="gone">

            <EditText
                android:id="@+id/et_search_keyword"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="输入歌曲名或歌手..."
                android:textColor="#ffffff"
                android:textColorHint="#777777"
                android:singleLine="true" />

            <Button
                android:id="@+id/btn_search_submit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="搜索" />
        </LinearLayout>

        <!-- 主体：左侧歌曲列表 + 右侧当前播放队列 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <!-- 主浏览区 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:id="@+id/tv_list_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentLeft="true"
                        android:layout_centerVertical="true"
                        android:text="歌单列表"
                        android:textColor="#a0a5b5"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/btn_back"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        android:text="返回列表"
                        android:textSize="11sp"
                        android:visibility="gone" />
                </RelativeLayout>

                <ListView
                    android:id="@+id/list_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:divider="#242730"
                    android:dividerHeight="1dp" />
            </LinearLayout>

            <!-- 右侧面板：当前正在播放队列 -->
            <LinearLayout
                android:id="@+id/layout_queue_panel"
                android:layout_width="280dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="8dp"
                android:layout_marginLeft="6dp"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="当前播放列表"
                        android:textColor="#ffffff"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_close_queue"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_alignParentRight="true"
                        android:text="关闭"
                        android:textSize="11sp" />
                </RelativeLayout>

                <ListView
                    android:id="@+id/lv_queue"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:divider="#333842"
                    android:dividerHeight="1dp" />
            </LinearLayout>

        </LinearLayout>

        <!-- 底部常驻播放器条 -->
        <LinearLayout
            android:id="@+id/layout_bottom_player"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_card"
            android:padding="6dp"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp"
            android:clickable="true"
            android:focusable="true">

            <!-- 左侧：进入播放详情页按钮 -->
            <Button
                android:id="@+id/btn_open_detail"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="歌词/详情"
                android:textSize="12sp" />

            <!-- 中间：歌曲标题、进度条与播放控制 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingLeft="8dp"
                android:paddingRight="8dp">

                <TextView
                    android:id="@+id/tv_current_song"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="未在播放"
                    android:textColor="#ffffff"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:singleLine="true" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <SeekBar
                        android:id="@+id/seek_bar"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="100" />

                    <TextView
                        android:id="@+id/tv_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00:00 / 00:00"
                        android:textColor="#888c99"
                        android:textSize="11sp"
                        android:paddingLeft="4dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <Button
                        android:id="@+id/btn_mode"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="列表循环"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btn_prev"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:minWidth="65dp"
                        android:text="上一首"
                        android:textSize="12sp"
                        android:layout_marginLeft="6dp" />

                    <Button
                        android:id="@+id/btn_play_pause"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:minWidth="75dp"
                        android:text="播放"
                        android:textSize="12sp"
                        android:layout_marginLeft="6dp" />

                    <Button
                        android:id="@+id/btn_next"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:minWidth="65dp"
                        android:text="下一首"
                        android:textSize="12sp"
                        android:layout_marginLeft="6dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 右侧：查看当前播放列表按钮 -->
            <Button
                android:id="@+id/btn_toggle_queue"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="播放列表"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- 第二层：独立播放详情页（防穿透，双栏视效） -->
    <LinearLayout
        android:id="@+id/layout_detail_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#16181d"
        android:padding="12dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <!-- 详情页顶栏：收起按钮、标题、常亮开关与列表切换按钮 -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="40dp">

            <Button
                android:id="@+id/btn_close_detail"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:text="收起详情"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="正在播放"
                android:textColor="#ffffff"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_detail_keep_screen"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:text="常亮: 关"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btn_detail_queue"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:text="播放列表"
                    android:textSize="12sp"
                    android:layout_marginLeft="6dp" />
            </LinearLayout>
        </RelativeLayout>

        <!-- 平板双栏展示：左侧封面与控制，右侧（歌词/列表切换） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <!-- 左栏：大封面 + 曲名歌手 + 控制 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_card"
                android:padding="12dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iv_detail_cover"
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    android:scaleType="centerCrop"
                    android:src="@android:drawable/ic_menu_report_image"
                    android:background="#111317" />

                <TextView
                    android:id="@+id/tv_detail_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="歌曲名称"
                    android:textColor="#ffffff"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/tv_detail_artist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="歌手名称"
                    android:textColor="#a0a5b5"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp"
                    android:singleLine="true" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="10dp">

                    <SeekBar
                        android:id="@+id/detail_seek_bar"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="100" />

                    <TextView
                        android:id="@+id/tv_detail_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00:00 / 00:00"
                        android:textColor="#888c99"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="8dp">

                    <Button
                        android:id="@+id/btn_detail_mode"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="列表循环"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btn_detail_prev"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:minWidth="65dp"
                        android:text="上一首"
                        android:textSize="12sp"
                        android:layout_marginLeft="6dp" />

                    <Button
                        android:id="@+id/btn_detail_play_pause"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:minWidth="75dp"
                        android:text="播放"
                        android:textSize="12sp"
                        android:layout_marginLeft="6dp" />

                    <Button
                        android:id="@+id/btn_detail_next"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:minWidth="65dp"
                        android:text="下一首"
                        android:textSize="12sp"
                        android:layout_marginLeft="6dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 右栏：歌词与队列双视图切换区 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.2"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="12dp"
                android:layout_marginLeft="8dp"
                android:clickable="true"
                android:focusable="true">

                <!-- 视图 A：滚动歌词 -->
                <LinearLayout
                    android:id="@+id/layout_detail_lyrics_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="歌词"
                        android:textColor="#a0a5b5"
                        android:textSize="13sp"
                        android:layout_marginBottom="6dp" />

                    <ScrollView
                        android:id="@+id/scroll_lyrics"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fillViewport="true"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/layout_lyrics_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:paddingTop="150dp"
                            android:paddingBottom="150dp" />
                    </ScrollView>
                </LinearLayout>

                <!-- 视图 B：当前播放列表 -->
                <LinearLayout
                    android:id="@+id/layout_detail_queue_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="当前播放列表"
                        android:textColor="#a0a5b5"
                        android:textSize="13sp"
                        android:layout_marginBottom="6dp" />

                    <ListView
                        android:id="@+id/lv_detail_queue"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:divider="#333842"
                        android:dividerHeight="1dp" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
