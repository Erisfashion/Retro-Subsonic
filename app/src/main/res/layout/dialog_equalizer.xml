<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="720dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1f2229"
    android:padding="14dp">

    <!-- 顶栏：标题与关闭按钮 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:text="音效与均衡器调节"
            android:textColor="#ffffff"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_eq_close"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_alignParentRight="true"
            android:text="完成 ✕"
            android:textSize="12sp" />
    </RelativeLayout>

    <!-- 主体左右双栏（完美契合横屏平板视效） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- 左栏：环境混响 + 3D立体声 + 重低音 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="环境混响音效"
                android:textColor="#00e5ff"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- 混响单选组 -->
            <RadioGroup
                android:id="@+id/rg_reverb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <RadioButton
                    android:id="@+id/rb_rev_none"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="无混响"
                    android:textColor="#cccccc"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/rb_rev_room"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="室内 (小房间)"
                    android:textColor="#cccccc"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/rb_rev_hall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="大厅 (音乐厅)"
                    android:textColor="#cccccc"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/rb_rev_large"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="教堂 / 影院"
                    android:textColor="#cccccc"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/rb_rev_plate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="板式混响"
                    android:textColor="#cccccc"
                    android:textSize="13sp" />
            </RadioGroup>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#333842"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp" />

            <!-- 3D 立体声环绕 -->
            <CheckBox
                android:id="@+id/cb_virt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3D 立体声环绕"
                android:textColor="#ffffff"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <SeekBar
                    android:id="@+id/sb_virt"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100" />

                <TextView
                    android:id="@+id/tv_virt_val"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textColor="#aaaaaa"
                    android:textSize="12sp"
                    android:gravity="right" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#333842"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp" />

            <!-- 重低音增强 -->
            <CheckBox
                android:id="@+id/cb_bass"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="重低音增强 (Bass Boost)"
                android:textColor="#ffffff"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <SeekBar
                    android:id="@+id/sb_bass"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100" />

                <TextView
                    android:id="@+id/tv_bass_val"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textColor="#aaaaaa"
                    android:textSize="12sp"
                    android:gravity="right" />
            </LinearLayout>

        </LinearLayout>

        <!-- 右栏：均衡器 (EQ) 与常用预设 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.3"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="10dp"
            android:layout_marginLeft="10dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="均衡器 (EQ)"
                    android:textColor="#00e5ff"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_eq_reset"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_alignParentRight="true"
                    android:text="重置"
                    android:textSize="11sp" />
            </RelativeLayout>

            <!-- 5 频段调节容器 -->
            <LinearLayout
                android:id="@+id/layout_eq_bands"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="6dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#333842"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp" />

            <!-- 预设按钮组 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="常用预设风格"
                android:textColor="#888c99"
                android:textSize="12sp"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_preset_pop"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="流行"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btn_preset_rock"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="摇滚"
                    android:textSize="11sp"
                    android:layout_marginLeft="4dp" />

                <Button
                    android:id="@+id/btn_preset_dance"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="舞曲"
                    android:textSize="11sp"
                    android:layout_marginLeft="4dp" />

                <Button
                    android:id="@+id/btn_preset_classic"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="古典"
                    android:textSize="11sp"
                    android:layout_marginLeft="4dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <Button
                    android:id="@+id/btn_preset_vocal"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="人声"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btn_preset_bass"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="重低音"
                    android:textSize="11sp"
                    android:layout_marginLeft="4dp" />

                <Button
                    android:id="@+id/btn_preset_flat"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="默认平直"
                    android:textSize="11sp"
                    android:layout_marginLeft="4dp" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
