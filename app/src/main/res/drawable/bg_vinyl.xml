<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 外圈黑胶唱片大圆盘 -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#101114" />
            <stroke android:width="2dp" android:color="#2c2f38" />
            <size android:width="240dp" android:height="240dp" />
        </shape>
    </item>
    <!-- 唱片音轨沟槽细微纹理环 1 -->
    <item android:top="16dp" android:bottom="16dp" android:left="16dp" android:right="16dp">
        <shape android:shape="oval">
            <stroke android:width="1dp" android:color="#1a1c22" />
        </shape>
    </item>
    <!-- 唱片音轨沟槽细微纹理环 2 -->
    <item android:top="32dp" android:bottom="32dp" android:left="32dp" android:right="32dp">
        <shape android:shape="oval">
            <stroke android:width="1dp" android:color="#242730" />
        </shape>
    </item>
    <!-- 唱片音轨沟槽细微纹理环 3 -->
    <item android:top="48dp" android:bottom="48dp" android:left="48dp" android:right="48dp">
        <shape android:shape="oval">
            <stroke android:width="1dp" android:color="#1a1c22" />
        </shape>
    </item>
</layer-list>
